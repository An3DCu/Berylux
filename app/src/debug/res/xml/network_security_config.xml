<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: plain HTTP to the API on this computer, which the emulator sees as 10.0.2.2.
     Every other address, and every release build, stays HTTPS only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
