<?xml version="1.0" encoding="utf-8"?>
<!-- Plain working copy. The character round rewrites it in the case-file voice. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Lux is a unit, like km: "1 Lux", "500 Lux". -->
    <string name="progress_title">Your record</string>
    <string name="progress_to_next" tools:ignore="PluralsCandidate">%1$d Lux to %2$s</string>
    <string name="progress_top_rank">Top rank. Nowhere higher to go.</string>

    <string name="progress_streak_title">Streak</string>
    <plurals name="progress_streak_days">
        <item quantity="one">%d day</item>
        <item quantity="other">%d days</item>
    </plurals>
    <plurals name="progress_streak_longest">
        <item quantity="one">Longest: %d day</item>
        <item quantity="other">Longest: %d days</item>
    </plurals>
    <string name="progress_streak_done_today">Today\'s on the record.</string>
    <string name="progress_streak_not_yet">Close a case today to keep it going.</string>
    <string name="progress_freeze_banked">A freeze is banked: it saves the next missed day.</string>
    <string name="progress_freeze_none">No freeze banked. Every 7 days in a row earn one.</string>
    <plurals name="progress_frozen_days">
        <item quantity="one">%d missed day saved by a freeze.</item>
        <item quantity="other">%d missed days saved by freezes.</item>
    </plurals>

    <string name="progress_rivals">Rivals this week</string>
    <string name="progress_file_room">The file room</string>
    <string name="progress_achievements_title">Commendations · %1$d of %2$d</string>
    <string name="progress_new">New</string>
    <string name="progress_locked">Sealed</string>
    <string name="progress_unlocked_on">Earned %1$s</string>
    <string name="progress_error">Your record wouldn\'t open. Restart the app to try again.</string>

    <string name="progress_rank_progress">Progress to the next rank</string>
    <!-- The Lux under the rank, then how far to the next one: 15 Lux · 485 Lux to Heliodor. -->
    <string name="progress_lux_line" tools:ignore="PluralsCandidate">%1$d Lux · %2$s</string>

    <!-- The file room: the record over time, opened from Progress. -->
    <string name="file_room_title">The file room</string>
    <string name="file_room_empty">Nothing closed yet. The record starts with the first case.</string>
    <string name="file_room_lux_title">Lux by week</string>
    <string name="file_room_weeks_ago">12 weeks ago</string>
    <string name="file_room_this_week">This week</string>
    <string name="file_room_calendar_title">Streak calendar</string>
    <string name="file_room_closed">Closed</string>
    <string name="file_room_saved">Saved by a freeze</string>
    <string name="file_room_categories_title">By category</string>
    <string name="file_room_error">The file room wouldn\'t open. Restart the app to try again.</string>
    <!-- What TalkBack reads for each chart, in one line. -->
    <string name="file_room_lux_summary" tools:ignore="PluralsCandidate">Lux by week: %1$,d this week, %2$,d over 12 weeks, best week %3$,d.</string>
    <string name="file_room_calendar_summary" tools:ignore="PluralsCandidate">Streak calendar: %1$d of the last %2$d days closed.</string>
    <plurals name="file_room_calendar_saved">
        <item quantity="one">%d saved by a freeze.</item>
        <item quantity="other">%d saved by freezes.</item>
    </plurals>
    <string name="file_room_category_row" tools:ignore="PluralsCandidate">%1$s: %2$d closed</string>
