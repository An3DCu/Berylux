<?xml version="1.0" encoding="utf-8"?>
<!-- Plain working copy. The character round rewrites it in the case-file voice. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Lux is a unit, like km: "1 Lux", "500 Lux". The day always has 5 slots. -->
    <string name="today_open_profile">Open your profile</string>
    <string name="today_rank_line" tools:ignore="PluralsCandidate">%1$s · %2$d Lux</string>
    <string name="today_slots" tools:ignore="PluralsCandidate">On the desk: %1$d of %2$d</string>

    <string name="today_daily_title">Daily case</string>
    <string name="today_bonus_title">Bonus case</string>
    <string name="today_picks_title">Leads</string>
    <string name="today_filter_all">All</string>
    <string name="today_nothing_here">No leads here today.</string>

    <string name="today_card_meta">%1$s · %2$s</string>
    <string name="today_card_lux" tools:ignore="PluralsCandidate">+%1$d Lux</string>
    <string name="today_card_take">Take the case</string>
    <string name="today_card_taken">On your desk</string>

    <string name="today_taken">On your desk: %1$s</string>
    <string name="today_day_full">Your desk holds 5 cases a day. Drop one to take another.</string>
    <string name="today_already_taken">That case is already on your desk.</string>
    <string name="today_failed">That didn\'t go through. Try again.</string>
    <string name="today_error">Today\'s docket wouldn\'t open. Restart the app to try again.</string>

    <string name="today_heading">Today\'s docket</string>
    <!-- The sign's day count: letters lit this week, then the whole streak from day 29. -->
    <string name="today_sign_none">No streak yet</string>
    <string name="today_sign_week">Day %1$d of 7</string>
    <string name="today_sign_stamped">Day %1$d</string>
    <plurals name="today_sign_description">
        <item quantity="one">Streak: %d day</item>
        <item quantity="other">Streak: %d days</item>
    </plurals>
    <string name="today_rank_progress">Progress to the next rank</string>
    <string name="today_slots_description" tools:ignore="PluralsCandidate">%1$d of %2$d cases on the desk</string>
</resources>
