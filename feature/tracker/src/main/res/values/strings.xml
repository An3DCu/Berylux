<?xml version="1.0" encoding="utf-8"?>
<!-- Plain working copy. The character round rewrites it in the case-file voice. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Lux is a unit, like km: "1 Lux", "500 Lux". The day always has 5 slots. -->
    <string name="cases_today_title" tools:ignore="PluralsCandidate">Today · %1$d of %2$d cases</string>
    <string name="cases_today_empty">No cases today. Take one on from Today.</string>
    <string name="cases_go_to_today">Go to Today</string>
    <string name="cases_history_title">Earlier</string>
    <string name="cases_history_empty">Nothing earlier yet.</string>
    <string name="cases_day_summary" tools:ignore="PluralsCandidate">%1$s · %2$d closed · +%3$d Lux</string>

    <string name="cases_card_meta">%1$s · %2$s</string>
    <string name="cases_status_open">Open</string>
    <string name="cases_status_closed">Closed</string>
    <string name="cases_status_cold">Cold</string>
    <string name="cases_status_dropped">Dropped</string>
    <string name="cases_lux_pays" tools:ignore="PluralsCandidate">+%1$d Lux</string>
    <string name="cases_lux_earned" tools:ignore="PluralsCandidate">+%1$d Lux earned</string>
    <string name="cases_lux_cost" tools:ignore="PluralsCandidate">−%1$d Lux</string>
    <string name="cases_went_cold_note">Went cold when its day ended</string>
    <string name="cases_close">Close</string>
    <string name="cases_drop">Drop</string>

    <string name="cases_close_title">Close \"%1$s\"?</string>
    <string name="cases_close_text" tools:ignore="PluralsCandidate">You get %1$d Lux. A closed case can\'t be opened again.</string>
    <string name="cases_close_text_custom">Your own cases give no Lux, but the day counts for your streak.</string>
    <string name="cases_close_confirm">Close it</string>
    <string name="cases_close_dismiss">Not yet</string>
    <string name="cases_drop_title">Drop \"%1$s\"?</string>
    <string name="cases_drop_text" tools:ignore="PluralsCandidate">It costs %1$d Lux and frees the slot.</string>
    <string name="cases_drop_confirm">Drop</string>
    <string name="cases_drop_dismiss">Keep it</string>

    <string name="cases_closed" tools:ignore="PluralsCandidate">Closed: %1$s, +%2$d Lux</string>
    <string name="cases_dropped" tools:ignore="PluralsCandidate">Dropped: %1$s, −%2$d Lux</string>
    <string name="cases_went_cold">That case went cold when the day ended.</string>
    <string name="cases_failed">That didn\'t work. Try again.</string>
    <string name="cases_error">Your cases couldn\'t be loaded. Restart the app to try again.</string>
